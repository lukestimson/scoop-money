{
  "name": "scoop-money",
  "version": "1.0.0",
  "description": "Scoop Money — a local-first personal finance desktop app.",
  "main": "./out/main/index.js",
  "author": "Scoop Money",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:agent-bridge": "node --experimental-strip-types --test src/main/agentBridgeCore.test.ts",
    "test:ai-models": "node --experimental-strip-types --test src/main/aiModelCatalog.test.ts",
    "test:transaction-income": "node --experimental-strip-types --test src/main/transactionIncomeTransfer.test.ts",
    "test:importer": "TZ=America/Los_Angeles node --experimental-strip-types --test src/main/importerCore.test.ts",
    "agent:rpc": "node scripts/scoop_money_agent_rpc.mjs",
    "agent:status": "node scripts/scoop_money_agent_rpc.mjs agent.status",
    "start": "node ./scripts/run-electron-vite.mjs preview",
    "dev": "node ./scripts/run-electron-vite.mjs dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1 --port 5175",
    "build": "npm run typecheck && electron-vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "openai": "^6.37.0",
    "papaparse": "^5.5.3",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
